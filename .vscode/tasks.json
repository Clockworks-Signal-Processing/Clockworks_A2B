{
    "version": "2.0.0",
    "tasks": [
        // -------------------------------------------------------------------
        // RP2040 fixed (a2bcpp/examples/fixed/rp2040): Debug build in build/a2b-fixed-rp2040, Release build in
        // build/a2b-fixed-rp2040-release (the A2B menu uses these). Each configure sets the build type: the
        // example doesn't, and the Pico SDK would default to Release.
        // -------------------------------------------------------------------
        {
            "label": "RP2040 fixed: Clean",
            "type": "process",
            "command": "${env:USERPROFILE}/.pico-sdk/cmake/v3.28.6/bin/cmake.exe",
            "args": ["-E", "rm", "-rf", "build/a2b-fixed-rp2040", "build/a2b-fixed-rp2040-release"],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "RP2040 fixed: Configure (Debug)",
            "hide": true,
            "type": "process",
            "command": "${env:USERPROFILE}/.pico-sdk/cmake/v3.28.6/bin/cmake.exe",
            "args": [
                "-S", "a2bcpp/examples/fixed/rp2040", "-B", "build/a2b-fixed-rp2040", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_MAKE_PROGRAM=${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1/ninja.exe"
            ],
            // The same environment as the integrated terminal's (settings.json): without
            // it, a PICO_SDK_PATH set in the user's environment makes the example skip the
            // extension's setup and then not find the toolchain or picotool.
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PICO_SDK_PATH": "${env:USERPROFILE}/.pico-sdk/sdk/2.0.0",
                    "PICO_TOOLCHAIN_PATH": "${env:USERPROFILE}/.pico-sdk/toolchain/13_2_Rel1",
                    "Path": "${env:USERPROFILE}/.pico-sdk/toolchain/13_2_Rel1/bin;${env:USERPROFILE}/.pico-sdk/picotool/2.0.0/picotool;${env:USERPROFILE}/.pico-sdk/cmake/v3.28.6/bin;${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1;${env:PATH}"
                }
            },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "RP2040 fixed: Build (Debug)",
            "type": "process",
            "command": "${env:USERPROFILE}/.pico-sdk/cmake/v3.28.6/bin/cmake.exe",
            "args": ["--build", "build/a2b-fixed-rp2040"],
            // The same environment as the integrated terminal's (settings.json): without
            // it, a PICO_SDK_PATH set in the user's environment makes the example skip the
            // extension's setup and then not find the toolchain or picotool.
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PICO_SDK_PATH": "${env:USERPROFILE}/.pico-sdk/sdk/2.0.0",
                    "PICO_TOOLCHAIN_PATH": "${env:USERPROFILE}/.pico-sdk/toolchain/13_2_Rel1",
                    "Path": "${env:USERPROFILE}/.pico-sdk/toolchain/13_2_Rel1/bin;${env:USERPROFILE}/.pico-sdk/picotool/2.0.0/picotool;${env:USERPROFILE}/.pico-sdk/cmake/v3.28.6/bin;${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1;${env:PATH}"
                }
            },
            "dependsOn": "RP2040 fixed: Configure (Debug)",
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"]
            }
        },
        {
            "label": "RP2040 fixed: Configure (Release)",
            "hide": true,
            "type": "process",
            "command": "${env:USERPROFILE}/.pico-sdk/cmake/v3.28.6/bin/cmake.exe",
            "args": [
                "-S", "a2bcpp/examples/fixed/rp2040", "-B", "build/a2b-fixed-rp2040-release", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_MAKE_PROGRAM=${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1/ninja.exe"
            ],
            // The same environment as the integrated terminal's (settings.json): without
