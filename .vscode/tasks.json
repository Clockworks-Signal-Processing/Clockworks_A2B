            // extension's setup and then not find the toolchain or picotool.
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PICO_SDK_PATH": "${env:USERPROFILE}/.pico-sdk/sdk/2.0.0",
                    "PICO_TOOLCHAIN_PATH": "${env:USERPROFILE}/.pico-sdk/toolchain/13_2_Rel1",
                    "Path": "${env:USERPROFILE}/.pico-sdk/toolchain/13_2_Rel1/bin;${env:USERPROFILE}/.pico-sdk/picotool/2.0.0/picotool;${env:USERPROFILE}/.pico-sdk/cmake/v3.28.6/bin;${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1;${env:PATH}"
                }
            },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "RP2040 fixed: Build (Release)",
            "type": "process",
            "command": "${env:USERPROFILE}/.pico-sdk/cmake/v3.28.6/bin/cmake.exe",
            "args": ["--build", "build/a2b-fixed-rp2040-release"],
            // The same environment as the integrated terminal's (settings.json): without
            // it, a PICO_SDK_PATH set in the user's environment makes the example skip the
            // extension's setup and then not find the toolchain or picotool.
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PICO_SDK_PATH": "${env:USERPROFILE}/.pico-sdk/sdk/2.0.0",
                    "PICO_TOOLCHAIN_PATH": "${env:USERPROFILE}/.pico-sdk/toolchain/13_2_Rel1",
                    "Path": "${env:USERPROFILE}/.pico-sdk/toolchain/13_2_Rel1/bin;${env:USERPROFILE}/.pico-sdk/picotool/2.0.0/picotool;${env:USERPROFILE}/.pico-sdk/cmake/v3.28.6/bin;${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1;${env:PATH}"
                }
            },
            "dependsOn": "RP2040 fixed: Configure (Release)",
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"]
            }
        },
        {
            // Builds Release, then programs it through the debug probe (CMSIS-DAP) and
            // restarts the board. Program output: the Pico's uart0 (GP0/GP1, 230400 baud).
            "label": "RP2040 fixed: Release (load and run)",
            "type": "process",
            "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            "args": [
                "-s", "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/scripts",
                "-f", "interface/cmsis-dap.cfg",
                "-f", "target/rp2040.cfg",
                "-c", "adapter speed 5000; program build/a2b-fixed-rp2040-release/a2b_fixed.elf verify reset exit"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "RP2040 fixed: Build (Release)",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
