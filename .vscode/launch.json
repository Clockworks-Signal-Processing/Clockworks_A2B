{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico Debug (Cortex-Debug)",
            "cwd": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/scripts",
            "executable": "${command:raspberry-pi-pico.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/${command:raspberry-pi-pico.getTarget}.cfg"
            ],
            "svdFile": "${env:USERPROFILE}/.pico-sdk/sdk/2.0.0/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "runToEntryPoint": "main",
            // Fix for no_flash binaries, where monitor reset halt doesn't do what is expected
            // Also works fine for flash binaries
            "overrideLaunchCommands": [
                "monitor reset init",
                "load \"${command:raspberry-pi-pico.launchTargetPath}\""
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ],
            // Build the Debug version (build/) first; the A2B menu's RP2040 Debug uses this.
            "preLaunchTask": "RP2040: Build (Debug)"
        },
        {
            "name": "Pico Debug (Cortex-Debug with external OpenOCD)",
            "cwd": "${workspaceRoot}",
            "executable": "${command:raspberry-pi-pico.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbTarget": "localhost:3333",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "svdFile": "${env:USERPROFILE}/.pico-sdk/sdk/2.0.0/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "runToEntryPoint": "main",
            // Give restart the same functionality as runToEntryPoint - main
            "postRestartCommands": [
                "break main",
                "continue"
            ]
        },
        {
            "name": "Pico Debug (C++ Debugger)",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "program": "${command:raspberry-pi-pico.launchTargetPath}",
            "MIMode": "gdb",
            "miDebuggerPath": "${command:raspberry-pi-pico.getGDBPath}",
            "miDebuggerServerAddress": "localhost:3333",
            "debugServerPath": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            "debugServerArgs": "-f interface/cmsis-dap.cfg -f target/${command:raspberry-pi-pico.getTarget}.cfg -c \"adapter speed 5000\"",
            "serverStarted": "Listening on port .* for gdb connections",
            "filterStderr": true,
            "hardwareBreakpoints": {
                "require": true,
                "limit": 4
            },
            "preLaunchTask": "Flash",
            "svdPath": "${env:USERPROFILE}/.pico-sdk/sdk/2.0.0/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd"
        },
        {
            // 64-bit Linux on the Raspberry Pi (app/linux_rpi). The pre-launch task builds,
            // deploys and starts gdbserver on the Pi ("a2b.piHost"/"a2b.piUser" in the VS Code
            // User settings); gdb-multiarch runs in the Debian WSL distro and connects to it.
            // Setup: Debian: sudo apt install gdb-multiarch   Pi: sudo apt install gdbserver
            // Works from any folder: wsl.exe starts in the repository (pipeCwd), which
            // Debian sees as /mnt/<drive>/..., so gdb finds the build output by its
            // relative path.
            "name": "Pi Debug (gdbserver, arm64)",
            "type": "cppdbg",
            "request": "launch",
            "program": "app/linux_rpi/build/a2b_pnp",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "targetArchitecture": "arm64",
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                // Full path, via Sysnative: the C/C++ extension's debug adapter is a
                // 32-bit program, which Windows redirects from System32 to SysWOW64
                // (no wsl.exe there). If a future 64-bit adapter can't find this
                // path, use "${env:windir}\\System32\\wsl.exe" instead.
                "pipeProgram": "${env:windir}\\Sysnative\\wsl.exe",
                // The debugger passes "<debuggerPath> --interpreter=mi" as ONE quoted
                // argument, so it must go through bash -c to be split into words.
                "pipeArgs": ["-d", "Debian", "--exec", "bash", "-c"],
                "debuggerPath": "/usr/bin/gdb-multiarch"
            },
            // Source paths in the program are Debian's view of the Windows drive.
            "sourceFileMap": {
                "/mnt/c": "C:\\",
                "/mnt/d": "D:\\",
                "/mnt/e": "E:\\",
                "/mnt/f": "F:\\"
            },
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "set sysroot /usr/aarch64-linux-gnu", "ignoreFailures": true },
                { "text": "set solib-search-path /usr/lib/aarch64-linux-gnu", "ignoreFailures": true }
            ],
            // With pipeTransport the debugger ignores miDebuggerServerAddress and runs the
            // program locally, so the launch steps are spelled out: load symbols, connect
            // to gdbserver on the Pi, and set a one-time breakpoint at main.
            // stopAtEntry doesn't work here: the debug engine takes the stop on connecting
            // to gdbserver as the entry point and continues. The engine doesn't know the
            // main breakpoint, so "unknownBreakpointHandling": "stop" makes it an ordinary
            // stop instead of "Exception has occurred".
            "customLaunchSetupCommands": [
                { "text": "-file-exec-and-symbols app/linux_rpi/build/a2b_pnp", "description": "load symbols" },
                { "text": "-target-select remote ${config:a2b.piHost}:2345", "description": "connect to gdbserver on the Pi" },
                { "text": "-break-insert -t main", "description": "stop at main" }
            ],
            "launchCompleteCommand": "exec-continue",
            "unknownBreakpointHandling": "stop",
            "preLaunchTask": "Linux arm64: Start gdbserver on Pi"
        },
        {
            // 64-bit Windows console app (app/windows), debugged locally with MSYS2 UCRT64's gdb
            // ("a2b.msys2Root", default C:/msys64). The program gets its own console window,
            // where it prints and reads commands. The USBi needs the WinUSB driver (README.md).
            "name": "Windows Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/app/windows/build/Debug/a2b_pnp.exe",
            // Startup script in cfg\: "a2b.windowsStartupScript" in .vscode/settings.json
            // (the program's own default is ini_EVAL_RJ45.txt, for ADI's evaluation board)
            "args": ["${config:a2b.windowsStartupScript}"],
            "cwd": "${workspaceFolder}/app/windows/build",
            "MIMode": "gdb",
            "miDebuggerPath": "${config:a2b.msys2Root}/ucrt64/bin/gdb.exe",
            "externalConsole": true,
            "stopAtEntry": true,
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "Windows: Build (Debug)"
        },
    ]
}
